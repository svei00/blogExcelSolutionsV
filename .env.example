# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real secrets (REBUILD_PLAN 3.5).

# MongoDB connection string.
MongoDB=

# Secret used to sign/verify JWT session tokens (api/controllers/auth.controller.js).
# Rotating this invalidates every existing session (everyone gets logged
# out) - that's expected and safe to do periodically, not a bug.
JWT_SECRET=

# Optional: ntfy.sh topic URL for a push notification when a Contact
# form lead comes in (api/utils/notifyLead.util.js). Pick a
# hard-to-guess topic name, e.g. https://ntfy.sh/excelsolutionsv-leads-x7q2,
# and subscribe to it in the ntfy app or web UI. Leave blank to disable.
NTFY_TOPIC_URL=

# Firebase Web API key for "Continue with Google" (client/src/firebase.js).
# Firebase Console > Project settings > General > Your apps > Web app >
# firebaseConfig.apiKey. This one is PUBLIC by design - it ships inside the
# JS bundle and only identifies the project; access is controlled by the
# Firebase Authorized-domains list and by the server verifying the ID token
# in api/controllers/auth.controller.js. It still lives here (not hardcoded)
# so the key can be rotated without a code change.
# The VITE_ prefix is what exposes it to the frontend build; vite.config.js
# sets envDir ".." so Vite reads this same repo-root file.
VITE_FIREBASE_API_KEY=
