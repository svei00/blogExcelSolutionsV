# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real secrets (REBUILD_PLAN 3.5).

# MongoDB connection string.
MongoDB=

# Secret used to sign/verify JWT session tokens (api/controllers/auth.controller.js).
# Rotating this invalidates every existing session (everyone gets logged
# out) - that's expected and safe to do periodically, not a bug.
JWT_SECRET=

# Optional: ntfy.sh topic URL for a push notification when a Contact
# form lead comes in (api/utils/notifyLead.util.js). Pick a
# hard-to-guess topic name, e.g. https://ntfy.sh/excelsolutionsv-leads-x7q2,
# and subscribe to it in the ntfy app or web UI. Leave blank to disable.
NTFY_TOPIC_URL=
